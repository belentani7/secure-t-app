# .env.example - Configuración de entorno para secure-t
# Copiar este archivo a .env y completar los valores antes de ejecutar la aplicación

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secure_t"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/secure_t"

# Authentication (OIDC / Keycloak when enabled)
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="secure-t"
KEYCLOAK_CLIENT_ID="secure-t-frontend"
KEYCLOAK_CLIENT_SECRET="change-this-secret"

# AI Gateway Configuration
AI_GATEWAY_URL="http://localhost:3001"
AI_GATEWAY_API_KEY="change-this-api-key"

# Voice Provider Configuration (Kokoro via Hugging Face, Chatterbox, etc.)
VOICE_PROVIDER="kokoro"
HF_API_KEY="hf_your-token-here"
HF_MODEL_TTS="hexgrad/Kokoro-82M"
CHATTERBOX_API_KEY="change-this-chatterbox-key"

# MinIO / S3 Storage (for artifacts, evidence, lab files)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="secure-t"
USE_MINIO_URL_PATH_STYLE="true"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Server Configuration
NODE_ENV="development"
PORT="3000"
HOST="localhost"

# Application Features
FEATURE_AI_AGENTS="true"
FEATURE_LABS="true"
FEATURE_NOTIFICATIONS="true"
FEATURE_RAG="true"
FEATURE_AUDIT="true"

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# Logging
LOG_LEVEL="debug"
LOG_PRETTY="true"